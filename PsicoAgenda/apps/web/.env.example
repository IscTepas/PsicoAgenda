# URL base de la API. Debe ser accesible desde el navegador (NEXT_PUBLIC_ se inlinea en el bundle).
NEXT_PUBLIC_API_URL="http://localhost:4000"

# URL del proyecto Supabase. Origen de la sesión de identidad.
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"

# Clave publicable del proyecto (antes `anon`). Solo habilita la Auth API:
# el backend es la única vía de acceso a los datos clínicos y la Data API está
# desactivada, así que esta clave no puede leer las tablas de `public`.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="<publishable-key>"

# Cuentas de prueba que la pantalla de login ofrece para rellenar el formulario.
# Formato: array JSON de {label, email, password, role, navItems}, con `role` en
# minúsculas (patient | psychologist | admin).
#
# Solo tiene efecto en desarrollo: la pantalla compara con `process.env.NODE_ENV`, que
# Next sustituye por una constante al compilar, de modo que un build de producción
# elimina el bloque entero. Aun así la variable se define solo en el `.env` local y no
# aquí, porque un NEXT_PUBLIC_ se inlinea en el bundle del navegador: escribir las
# contraseñas en un archivo versionado las publicaría en el repositorio.
# Déjala sin definir para no mostrar nada.
# NEXT_PUBLIC_DEMO_ACCOUNTS='[{"label":"Paciente","email":"...","password":"...","role":"patient","navItems":4}]'
