generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  previewFeatures     = ["partialIndexes"]
  importFileExtension = "js"
  moduleFormat        = "esm"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This table contains exclusion constraints and requires additional setup for migrations. Visit https://pris.ly/d/exclusion-constraints for more info.
model citas {
  id                 String              @id @db.Uuid
  psicologo_id       String              @db.Uuid
  paciente_id        String              @db.Uuid
  solicitud_id       String?             @unique @db.Uuid
  inicio             DateTime            @db.Timestamptz(3)
  fin                DateTime            @db.Timestamptz(3)
  estado             estado_cita         @default(PENDIENTE)
  modalidad          modalidad_cita      @default(PRESENCIAL)
  tipo_sesion        tipo_sesion
  motivo             String?
  notas_internas     String?
  motivo_cancelacion String?
  precio             Int?
  cancelada_por_id   String?             @db.Uuid
  cancelada_en       DateTime?           @db.Timestamptz(3)
  creado_en          DateTime            @default(now()) @db.Timestamptz(3)
  actualizado_en     DateTime            @updatedAt @db.Timestamptz(3)
  usuarios           usuarios?           @relation(fields: [cancelada_por_id], references: [id])
  pacientes          pacientes           @relation(fields: [paciente_id], references: [id])
  psicologos         psicologos          @relation(fields: [psicologo_id], references: [id])
  solicitudes_cita   solicitudes_cita?   @relation(fields: [solicitud_id], references: [id])
  entradas_bitacora  entradas_bitacora[]
  notificaciones     notificaciones[]
  pagos_honorarios   pagos_honorarios?

  @@index([paciente_id, inicio])
  @@index([psicologo_id, inicio])
  @@index([estado, inicio], map: "idx_citas_estado_inicio")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model consentimientos_informados {
  id             String                @id @db.Uuid
  paciente_id    String                @db.Uuid
  firmado_en     DateTime              @default(now()) @db.Timestamptz(3)
  documento      String
  documento_url  String?
  tutor_legal_id String?               @db.Uuid
  estado         estado_consentimiento @default(FIRMADO)
  retirado_en    DateTime?             @db.Timestamptz(3)
  creado_en      DateTime              @default(now()) @db.Timestamptz(3)
  pacientes      pacientes             @relation(fields: [paciente_id], references: [id])
  tutores        tutores?              @relation(fields: [tutor_legal_id], references: [id])

  @@index([paciente_id, firmado_en])
  @@index([tutor_legal_id])
}

model contactos_emergencia {
  id              String    @id @db.Uuid
  paciente_id     String    @unique(map: "ux_contacto_principal", where: raw("es_principal")) @db.Uuid
  nombre_completo String
  telefono        String
  parentesco      String?
  es_principal    Boolean   @default(false)
  creado_en       DateTime  @default(now()) @db.Timestamptz(3)
  pacientes       pacientes @relation(fields: [paciente_id], references: [id], onDelete: Cascade)

  @@index([paciente_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model entradas_bitacora {
  id                   String                @id @db.Uuid
  expediente_id        String                @db.Uuid
  cita_id              String?               @db.Uuid
  psicologo_id         String                @db.Uuid
  fecha_sesion         DateTime              @default(now()) @db.Timestamptz(3)
  notas_sesion         String
  objetivos_trabajados String?
  plan_proxima_sesion  String?
  estado_general       String?
  progreso             String?
  version              Int                   @default(1)
  creado_en            DateTime              @default(now()) @db.Timestamptz(3)
  actualizado_en       DateTime              @updatedAt @db.Timestamptz(3)
  citas                citas?                @relation(fields: [cita_id], references: [id])
  expedientes_clinicos expedientes_clinicos  @relation(fields: [expediente_id], references: [id])
  psicologos           psicologos            @relation(fields: [psicologo_id], references: [id])
  revisiones_bitacora  revisiones_bitacora[]

  @@index([cita_id])
  @@index([expediente_id, fecha_sesion])
  @@index([psicologo_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model expedientes_clinicos {
  id                      String              @id @db.Uuid
  paciente_id             String              @unique @db.Uuid
  abierto_en              DateTime            @default(now()) @db.Timestamptz(3)
  motivo_consulta         String?
  antecedentes            String?
  diagnostico             String?
  observaciones_generales String?
  estado                  estado_expediente   @default(ACTIVO)
  conservar_hasta         DateTime?           @db.Date
  actualizado_en          DateTime            @updatedAt @db.Timestamptz(3)
  entradas_bitacora       entradas_bitacora[]
  pacientes               pacientes           @relation(fields: [paciente_id], references: [id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model horarios_psicologo {
  id           String     @id @db.Uuid
  psicologo_id String     @db.Uuid
  dia_semana   Int        @db.SmallInt
  hora_inicio  DateTime   @db.Time(0)
  hora_fin     DateTime   @db.Time(0)
  activo       Boolean    @default(true)
  psicologos   psicologos @relation(fields: [psicologo_id], references: [id], onDelete: Cascade)

  @@unique([psicologo_id, dia_semana, hora_inicio])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model notificaciones {
  id              String             @id @db.Uuid
  usuario_id      String             @db.Uuid
  cita_id         String?            @db.Uuid
  tipo            tipo_notificacion
  canal           canal_notificacion
  asunto          String
  mensaje         String
  estado          estado_envio       @default(PENDIENTE)
  programada_para DateTime?          @db.Timestamptz(3)
  enviada_en      DateTime?          @db.Timestamptz(3)
  error           String?
  intentos        Int                @default(0)
  creado_en       DateTime           @default(now()) @db.Timestamptz(3)
  citas           citas?             @relation(fields: [cita_id], references: [id], onDelete: Cascade)
  usuarios        usuarios           @relation(fields: [usuario_id], references: [id])

  @@index([programada_para], map: "idx_notificaciones_pendientes", where: raw("(estado = 'PENDIENTE'::estado_envio)"))
  @@index([cita_id])
  @@index([estado, programada_para])
  @@index([usuario_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model pacientes {
  id                         String                       @id @db.Uuid
  usuario_id                 String                       @unique @db.Uuid
  fecha_nacimiento           DateTime?                    @db.Date
  sexo                       String?
  direccion                  String?
  tutor_legal_id             String?                      @db.Uuid
  psicologo_id               String?                      @db.Uuid
  citas                      citas[]
  consentimientos_informados consentimientos_informados[]
  contactos_emergencia       contactos_emergencia?
  expedientes_clinicos       expedientes_clinicos?
  psicologos                 psicologos?                  @relation(fields: [psicologo_id], references: [id], onDelete: Restrict)
  tutores                    tutores?                     @relation(fields: [tutor_legal_id], references: [id], onDelete: Restrict)
  usuarios                   usuarios                     @relation(fields: [usuario_id], references: [id])
  solicitudes_cita           solicitudes_cita[]

  @@index([psicologo_id])
  @@index([tutor_legal_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model pagos_honorarios {
  id             String      @id @db.Uuid
  cita_id        String      @unique @db.Uuid
  monto          Decimal     @db.Decimal(12, 2)
  estado         estado_pago @default(PENDIENTE)
  pagado_en      DateTime?   @db.Timestamptz(3)
  creado_en      DateTime    @default(now()) @db.Timestamptz(3)
  actualizado_en DateTime    @updatedAt @db.Timestamptz(3)
  citas          citas       @relation(fields: [cita_id], references: [id])

  @@index([estado, pagado_en])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model psicologos {
  id                 String               @id @db.Uuid
  usuario_id         String               @unique @db.Uuid
  cedula_profesional String               @unique
  especialidad       String?
  anios_experiencia  Int?
  biografia          String?
  citas              citas[]
  entradas_bitacora  entradas_bitacora[]
  horarios_psicologo horarios_psicologo[]
  pacientes          pacientes[]
  usuarios           usuarios             @relation(fields: [usuario_id], references: [id])
  reportes           reportes[]
  solicitudes_cita   solicitudes_cita[]
}

model registros_auditoria {
  id         String    @id @db.Uuid
  usuario_id String?   @db.Uuid
  accion     String
  entidad    String
  entidad_id String?
  detalle    Json?
  ip         String?
  creado_en  DateTime  @default(now()) @db.Timestamptz(3)
  usuarios   usuarios? @relation(fields: [usuario_id], references: [id])

  @@index([creado_en])
  @@index([entidad, entidad_id])
  @@index([usuario_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model reportes {
  id              String          @id @db.Uuid
  tipo            tipo_reporte
  psicologo_id    String?         @db.Uuid
  periodo_inicio  DateTime        @db.Date
  periodo_fin     DateTime        @db.Date
  formato         formato_reporte
  url_archivo     String?
  generado_por_id String?         @db.Uuid
  generado_en     DateTime        @default(now()) @db.Timestamptz(3)
  usuarios        usuarios?       @relation(fields: [generado_por_id], references: [id])
  psicologos      psicologos?     @relation(fields: [psicologo_id], references: [id])

  @@index([generado_en])
  @@index([generado_por_id])
  @@index([psicologo_id])
}

model revisiones_bitacora {
  id                   String            @id @db.Uuid
  entrada_id           String            @db.Uuid
  version              Int
  notas_sesion         String
  objetivos_trabajados String?
  plan_proxima_sesion  String?
  modificado_por_id    String?           @db.Uuid
  modificado_en        DateTime          @default(now()) @db.Timestamptz(3)
  entradas_bitacora    entradas_bitacora @relation(fields: [entrada_id], references: [id])
  usuarios             usuarios?         @relation(fields: [modificado_por_id], references: [id])

  @@unique([entrada_id, version])
  @@index([modificado_por_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model solicitudes_cita {
  id                String           @id @db.Uuid
  paciente_id       String           @db.Uuid
  psicologo_id      String           @db.Uuid
  inicio_solicitado DateTime         @db.Timestamptz(3)
  tipo_sesion       tipo_sesion
  modalidad         modalidad_cita   @default(PRESENCIAL)
  duracion_minutos  Int              @default(50)
  motivo            String?
  estado            estado_solicitud @default(PENDIENTE)
  creado_en         DateTime         @default(now()) @db.Timestamptz(3)
  atendida_en       DateTime?        @db.Timestamptz(3)
  citas             citas?
  pacientes         pacientes        @relation(fields: [paciente_id], references: [id])
  psicologos        psicologos       @relation(fields: [psicologo_id], references: [id])

  @@index([paciente_id])
  @@index([psicologo_id, estado])
}

model tutores {
  id                         String                       @id @db.Uuid
  nombre_completo            String
  telefono                   String?
  parentesco                 String?
  creado_en                  DateTime                     @default(now()) @db.Timestamptz(3)
  consentimientos_informados consentimientos_informados[]
  pacientes                  pacientes[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model usuarios {
  id                    String                @id @db.Uuid
  correo                String                @unique
  nombre_completo       String
  telefono              String?
  rol                   rol_usuario           @default(PACIENTE)
  activo                Boolean               @default(true)
  zona_horaria          String                @default("UTC")
  foto_perfil_url       String?
  notificar_whatsapp    Boolean               @default(false)
  notificar_correo      Boolean               @default(true)
  preferencias_interfaz Json?
  ultimo_acceso         DateTime?             @db.Timestamptz(3)
  creado_en             DateTime              @default(now()) @db.Timestamptz(3)
  actualizado_en        DateTime              @updatedAt @db.Timestamptz(3)
  citas                 citas[]
  notificaciones        notificaciones[]
  pacientes             pacientes?
  psicologos            psicologos?
  registros_auditoria   registros_auditoria[]
  reportes              reportes[]
  revisiones_bitacora   revisiones_bitacora[]
}

enum canal_notificacion {
  WHATSAPP
  CORREO
}

enum estado_cita {
  PENDIENTE
  CONFIRMADA
  CANCELADA
  COMPLETADA
  NO_ASISTIO
}

enum estado_consentimiento {
  FIRMADO
  RETIRADO
  VENCIDO
}

enum estado_envio {
  PENDIENTE
  ENVIADA
  FALLIDA
  CANCELADA
}

enum estado_expediente {
  ACTIVO
  INACTIVO
}

enum estado_pago {
  PENDIENTE
  PAGADO
  CONDONADO
}

enum estado_solicitud {
  PENDIENTE
  ACEPTADA
  RECHAZADA
  CANCELADA
}

enum formato_reporte {
  PDF
  XLSX
}

enum modalidad_cita {
  PRESENCIAL
  VIRTUAL
}

enum rol_usuario {
  PSICOLOGO
  PACIENTE
  ADMINISTRADOR
}

enum tipo_notificacion {
  RECORDATORIO
  CONFIRMACION
  CAMBIO
  CANCELACION
}

enum tipo_reporte {
  CITAS_PERIODO
  ASISTENCIA_CANCELACIONES
  PACIENTES_ATENDIDOS
  HONORARIOS
}

enum tipo_sesion {
  INDIVIDUAL
  PAREJA
  FAMILIAR
  CONSULTA_INICIAL
}
