// Prisma 7: el cliente se genera como código TypeScript en src/generated/prisma
// (provider `prisma-client`, cliente Rust-free). No se genera dentro de node_modules.
generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// La URL de conexión se configura en prisma.config.ts (no en el schema) para Prisma 7.

// --- Usuarios y roles ---

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  name         String
  phone        String?
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  psychologist  Psychologist?
  patient       Patient?
  twoFactorAuth TwoFactorAuth?
  reports       Report[]

  @@map("users")
}

enum UserRole {
  PSYCHOLOGIST
  PATIENT
  ADMIN
}

model Psychologist {
  id            String    @id @default(uuid())
  userId        String    @unique @map("user_id")
  licenseNumber String    @map("license_number")
  specialty     String?
  bio           String?
  /// Patients menores de edad bajo responsabilidad legal de este profesional.
  minorPatients Patient[] @relation("MinorPatients")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  logEntries   LogEntry[]

  @@unique([licenseNumber])
  @@map("psychologists")
}

model Patient {
  id              String    @id @default(uuid())
  userId          String    @unique @map("user_id")
  birthDate       DateTime? @map("birth_date") @db.Date
  gender          String?
  address         String?
  /// Responsable legal cuando el paciente es menor de edad (RD-11).
  isMinor         Boolean   @default(false) @map("is_minor")
  legalGuardianId String?   @map("legal_guardian_id")
  /// Psicólogo responsable de los menores de edad a su cargo.
  psychologistId  String?   @map("psychologist_id")

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  legalGuardian     LegalGuardian?     @relation("GuardianPatients", fields: [legalGuardianId], references: [id])
  psychologist      Psychologist?      @relation("MinorPatients", fields: [psychologistId], references: [id])
  emergencyContacts EmergencyContact[]
  appointments      Appointment[]
  clinicalRecord    ClinicalRecord?
  consents          InformedConsent[]
  notifications     Notification[]

  @@index([psychologistId])
  @@map("patients")
}

model LegalGuardian {
  id           String   @id @default(uuid())
  name         String
  email        String?
  phone        String?
  relationship String?
  documentId   String?  @map("document_id")
  createdAt    DateTime @default(now()) @map("created_at")

  patients Patient[]         @relation("GuardianPatients")
  consents InformedConsent[] @relation("GuardianConsents")

  @@map("legal_guardians")
}

model EmergencyContact {
  id           String   @id @default(uuid())
  patientId    String   @map("patient_id")
  name         String
  phone        String
  relationship String?
  isPrimary    Boolean  @default(false) @map("is_primary")
  createdAt    DateTime @default(now()) @map("created_at")

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@map("emergency_contacts")
}

model TwoFactorAuth {
  id         String    @id @default(uuid())
  userId     String    @unique @map("user_id")
  secret     String
  enabled    Boolean   @default(false)
  verifiedAt DateTime? @map("verified_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("two_factor_auth")
}

// --- Agenda ---

model Appointment {
  id               String              @id @default(uuid())
  psychologistId   String              @map("psychologist_id")
  patientId        String              @map("patient_id")
  startTime        DateTime            @map("start_time")
  durationMinutes  Int                 @default(50) @map("duration_minutes")
  status           AppointmentStatus   @default(PENDING)
  modality         AppointmentModality @default(IN_PERSON)
  reason           String?
  notes            String?
  /// Confirmación de asistencia del paciente.
  attendanceStatus AttendanceStatus?   @map("attendance_status")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  psychologist      Psychologist       @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
  patient           Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  logEntries        LogEntry[]
  notifications     Notification[]
  honorariumPayment HonorariumPayment?

  @@index([psychologistId, startTime])
  @@index([patientId, startTime])
  @@map("appointments")
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum AppointmentModality {
  IN_PERSON
  VIRTUAL
}

enum AttendanceStatus {
  ATTENDED
  NO_SHOW
}

// --- Expediente clínico ---

model ClinicalRecord {
  id                  String       @id @default(uuid())
  patientId           String       @unique @map("patient_id")
  openedAt            DateTime     @default(now()) @map("opened_at")
  diagnosis           String?
  background          String?
  generalObservations String?      @map("general_observations")
  status              RecordStatus @default(ACTIVE)
  updatedAt           DateTime     @updatedAt @map("updated_at")

  patient    Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  logEntries LogEntry[]

  @@map("clinical_records")
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

model LogEntry {
  id               String   @id @default(uuid())
  clinicalRecordId String   @map("clinical_record_id")
  appointmentId    String?  @map("appointment_id")
  sessionDate      DateTime @default(now()) @map("session_date")
  sessionNotes     String   @map("session_notes")
  psychologistId   String   @map("psychologist_id")
  version          Int      @default(1)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  clinicalRecord ClinicalRecord @relation(fields: [clinicalRecordId], references: [id], onDelete: Cascade)
  appointment    Appointment?   @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  psychologist   Psychologist   @relation(fields: [psychologistId], references: [id])

  @@index([clinicalRecordId, sessionDate])
  @@map("log_entries")
}

model InformedConsent {
  id              String        @id @default(uuid())
  patientId       String        @map("patient_id")
  signedAt        DateTime      @default(now()) @map("signed_at")
  document        String
  documentUrl     String?       @map("document_url")
  /// Tutor legal que firma cuando el paciente es menor de edad (RD-11).
  legalGuardianId String?       @map("legal_guardian_id")
  status          ConsentStatus @default(SIGNED)
  withdrawnAt     DateTime?     @map("withdrawn_at")
  createdAt       DateTime      @default(now()) @map("created_at")

  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  legalGuardian LegalGuardian? @relation("GuardianConsents", fields: [legalGuardianId], references: [id], onDelete: SetNull)

  @@index([patientId, signedAt])
  @@index([legalGuardianId])
  @@map("informed_consents")
}

enum ConsentStatus {
  SIGNED
  WITHDRAWN
  EXPIRED
}

// --- Notificaciones ---

model Notification {
  id            String              @id @default(uuid())
  patientId     String?             @map("patient_id")
  appointmentId String?             @map("appointment_id")
  channel       NotificationChannel
  subject       String
  message       String
  status        NotificationStatus  @default(PENDING)
  scheduledFor  DateTime?           @map("scheduled_for")
  sentAt        DateTime?           @map("sent_at")
  error         String?
  attempts      Int                 @default(0)
  createdAt     DateTime            @default(now()) @map("created_at")

  patient     Patient?     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([status, scheduledFor])
  @@map("notifications")
}

enum NotificationChannel {
  WHATSAPP
  EMAIL
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

// --- Reportes y honorarios ---

model Report {
  id            String       @id @default(uuid())
  type          String
  periodStart   DateTime     @map("period_start") @db.Date
  periodEnd     DateTime     @map("period_end") @db.Date
  generatedAt   DateTime     @default(now()) @map("generated_at")
  format        ReportFormat
  fileUrl       String?      @map("file_url")
  generatedById String?      @map("generated_by_id")

  generatedBy User? @relation(fields: [generatedById], references: [id], onDelete: SetNull)

  @@index([generatedAt])
  @@index([generatedById])
  @@map("reports")
}

enum ReportFormat {
  PDF
  XLSX
}

/// Control administrativo del estado de pago de honorarios (RD-14).
/// No constituye facturación electrónica.
model HonorariumPayment {
  id            String        @id @default(uuid())
  appointmentId String        @unique @map("appointment_id")
  amount        Decimal       @db.Decimal(12, 2)
  status        PaymentStatus @default(PENDING)
  paidAt        DateTime?     @map("paid_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([status, paidAt])
  @@map("honorarium_payments")
}

enum PaymentStatus {
  PENDING
  PAID
  WAIVED
}
