# --- Plataforma de datos (Supabase) ---

# URL de conexión a PostgreSQL gestionado vía Supavisor en MODO SESIÓN (puerto 5432).
#
# El usuario tiene la forma `<rol>.<ref_del_proyecto>`: Supavisor enruta por
# tenant y rechaza la conexión si falta el ref (error: `ENOTFOUND: tenant/user ...`).
# El proyecto aparece en Dashboard -> Project Settings -> API.
# El host del pooler es `aws-<N>-<region>.pooler.supabase.com`. El indice N no se
# adivina (`aws-0` no vale para todos los proyectos; un indice equivocado da
# `ENOTFOUND: tenant/user ... not found`): se copia de Project Settings -> Database.
#
# El modo directo (db.<ref>.supabase.co) es IPv6 y no es alcanzable desde entornos
# sin IPv6 global. El modo transacción (6543) se descarta: no soporta sentencias
# preparadas, que Prisma emite por debajo.
# No agregues `pgbouncer=true`: desactiva el caché de planes preparados y solo hace
# falta en modo transacción, que aquí no se usa.
# La string NO debe llevar parámetros ssl*: pg-connection-string los traduce a
# verify-full y falla contra el certificado de Supabase. El TLS se configura en
# src/lib/prisma.ts con un PoolConfig explícito.
DATABASE_URL="postgresql://prisma.<REF>@aws-<N>-<region>.pooler.supabase.com:5432/postgres"

# URL del proyecto Supabase. Origen del JWKS y del `issuer` con el que se validan
# los tokens de sesión. Es obligatoria en producción.
SUPABASE_URL="https://<ref>.supabase.co"

# Tamaño máximo del pool de conexiones de la API hacia la base de datos.
# Suma este valor por cada instancia desplegada: debe quedar por debajo del
# "Pool Size" de Supavisor para la combinación base-de-datos + rol.
DATABASE_POOL_MAX="5"

PORT=4000
NODE_ENV="development"

# Origen permitido por CORS (frontend en desarrollo).
CORS_ORIGIN="http://localhost:3000"

# --- Registro de usuarios (verificación por código) ---

# Clave de servicio de Supabase Auth (Dashboard -> Project Settings -> API ->
# service_role). Solo la usa apps/api, después de verificar el código de correo,
# para crear la cuenta ya confirmada. NUNCA la expongas en apps/web ni en
# variables NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# SMTP de Gmail para enviar el código de registro: requiere verificación en dos
# pasos en la cuenta Google y una contraseña de aplicación
# (https://myaccount.google.com/apppasswords). En producción son obligatorias;
# sin ellas la API arranca en modo degradado y escribe el código en consola.
GMAIL_USER="tu.correo@gmail.com"
GMAIL_APP_PASSWORD="abcd efgh ijkl mnop"


# WhatsApp vía n8n (opcional). Sin URL, los avisos de WhatsApp quedan PENDIENTES
# en la tabla `notificaciones` y se entregan solos cuando se configure. El API
# hace POST JSON { notificacionId, tipo, telefono, nombre, asunto, mensaje, cita }
# y n8n debe responder 2xx; cualquier otra respuesta se reintenta (hasta 5 veces).
N8N_WHATSAPP_WEBHOOK_URL=""
N8N_WEBHOOK_SECRET=""
