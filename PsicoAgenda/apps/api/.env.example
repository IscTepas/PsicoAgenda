# URL de conexión a PostgreSQL. La usa tanto Prisma CLI (prisma.config.ts) como la app.
DATABASE_URL=""

# Secreto para firmar los JWT. En producción es obligatorio (la app falla al arrancar si falta).
JWT_SECRET=""
JWT_EXPIRES_IN="7d"

# Habilita el endpoint de demo login (sin BD). En producción siempre está deshabilitado.
# En desarrollo se activa por defecto; usa "false" para desactivar.
ALLOW_DEMO_LOGIN="true"

PORT=4000
NODE_ENV="development"

# Origen permitido por CORS (frontend en desarrollo).
CORS_ORIGIN="http://localhost:3000"
