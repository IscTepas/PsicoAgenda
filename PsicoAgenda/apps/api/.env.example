# --- Plataforma de datos (Supabase) ---

# URL de conexión a PostgreSQL gestionado vía Supavisor en MODO SESIÓN (puerto 5432).
#
# El usuario tiene la forma `<rol>.<ref_del_proyecto>`: Supavisor enruta por
# tenant y rechaza la conexión si falta el ref (error: `ENOTFOUND: tenant/user ...`).
# El proyecto aparece en Dashboard -> Project Settings -> API.
# El host del pooler es `aws-<N>-<region>.pooler.supabase.com`. El indice N no se
# adivina (`aws-0` no vale para todos los proyectos; un indice equivocado da
# `ENOTFOUND: tenant/user ... not found`): se copia de Project Settings -> Database.
#
# El modo directo (db.<ref>.supabase.co) es IPv6 y no es alcanzable desde entornos
# sin IPv6 global. El modo transacción (6543) se descarta: no soporta sentencias
# preparadas, que Prisma emite por debajo.
# No agregues `pgbouncer=true`: desactiva el caché de planes preparados y solo hace
# falta en modo transacción, que aquí no se usa.
# La string NO debe llevar parámetros ssl*: pg-connection-string los traduce a
# verify-full y falla contra el certificado de Supabase. El TLS se configura en
# src/lib/prisma.ts con un PoolConfig explícito.
DATABASE_URL="postgresql://prisma.<REF>@aws-<N>-<region>.pooler.supabase.com:5432/postgres"

# --- Serverless (Vercel) ---
# Aquí arriba se describe el modo SESIÓN (5432), que es el correcto para un
# proceso de larga vida (dev local, Railway, una VM). En serverless hay N
# instancias, cada una con su propio pool, y el modo sesión agota el "Pool Size":
#   * puerto 6543 (modo transacción) en DATABASE_URL,
#   * DATABASE_POOL_MAX=1.
# Prisma 7 con `@prisma/adapter-pg` consulta a través del query compiler y `pg`
# no emite sentencias preparadas con nombre, así que 6543 debería funcionar. Si
# aparece `prepared statement "s0" already exists` en los logs, Supavisor tiene
# un modo que las admite en transacción; sin él, la alternativa es volver a 5432
# con DATABASE_POOL_MAX=1 y aceptar el límite de conexiones.

# URL del proyecto Supabase. Origen del JWKS y del `issuer` con el que se validan
# los tokens de sesión. Es obligatoria en producción.
SUPABASE_URL="https://<ref>.supabase.co"

# Tamaño máximo del pool de conexiones de la API hacia la base de datos.
# Suma este valor por cada instancia desplegada: debe quedar por debajo del
# "Pool Size" de Supavisor para la combinación base-de-datos + rol.
DATABASE_POOL_MAX="5"
# En serverless (Vercel) este valor debe ser 1: cada instancia abre su propio
# pool y con 5 por lambda se agota el "Pool Size" de Supavisor.

# --- Vista previa (Vercel) ---
# Vercel define NODE_ENV=production también en los previews. Sin esta marca y
# las variables del proyecto aislado, la API se niega a arrancar. Se define
# SOLO con alcance Preview, junto al DATABASE_URL y SUPABASE_URL del proyecto
# aislado (nunca los de producción).
# ENTORNO_BD="preview"

PORT=4000
NODE_ENV="development"

# Orígenes permitidos por CORS, separados por comas. Cada entrada admite `*`
# como comodín, pensado para los preview deployments de Vercel (cada rama recibe
# un subdominio distinto):
#
#   CORS_ORIGIN="https://psicoagenda.vercel.app,https://psicoagenda-web-*.vercel.app"
#
# Una petición sin cabecera `Origin` (curl, el cron) se permite: el navegador
# siempre la envía y no puede omitirla para saltarse CORS.
CORS_ORIGIN="http://localhost:3000"

# URL pública del frontend para los enlaces de recuperación de contraseña.
# Si falta, se usa el primer origen de CORS_ORIGIN sin comodín.
# WEB_URL="https://psicoagenda.vercel.app"

# --- Registro de usuarios (verificación por código) ---

# Clave de servicio de Supabase Auth (Dashboard -> Project Settings -> API ->
# service_role). Solo la usa apps/api, después de verificar el código de correo,
# para crear la cuenta ya confirmada. NUNCA la expongas en apps/web ni en
# variables NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# SMTP de Gmail para enviar el código de registro: requiere verificación en dos
# pasos en la cuenta Google y una contraseña de aplicación
# (https://myaccount.google.com/apppasswords). En producción son obligatorias;
# sin ellas la API arranca en modo degradado y escribe el código en consola.
GMAIL_USER="tu.correo@gmail.com"
GMAIL_APP_PASSWORD="abcd efgh ijkl mnop"


# API de WhatsApp Business (Cloud API). WHATSAPP_PHONE_ID es el ID del número
# emisor (no el teléfono) y WHATSAPP_ACCESS_TOKEN el token de acceso que entrega
# Meta. Sin ambos, los avisos de WhatsApp quedan PENDIENTES en la tabla
# `notificaciones` y se entregan solos cuando se configuren.
WHATSAPP_PHONE_ID=""
WHATSAPP_ACCESS_TOKEN=""

# Plantillas aprobadas para los avisos de cita. Hay dos formas de declararlas:
#
# 1. Plantilla única (WHATSAPP_TEMPLATE_NAME): todas las notificaciones usan la
#    misma plantilla. Útil para pruebas con la plantilla de ejemplo de Meta.
# 2. Por tipo de aviso (si WHATSAPP_TEMPLATE_NAME queda vacío): cada tipo usa su
#    propia plantilla. Los nombres que aparecen abajo son los valores por
#    defecto del programa; cámbialos por los de tus plantillas aprobadas en Meta.
#      - WHATSAPP_TEMPLATE_PSYCHOLOGIST: solicitudes/cancelaciones que llegan a la psicóloga
#      - WHATSAPP_TEMPLATE_PATIENT_NOTICE: confirmaciones/agendaciones/modificaciones al paciente
#      - WHATSAPP_TEMPLATE_PATIENT_CANCELLATION: rechazos/cancelaciones al paciente
#      - WHATSAPP_TEMPLATE_REMINDER: recordatorios (24 h y 2 h)
WHATSAPP_TEMPLATE_NAME="jaspers_market_order_confirmation_v1"
# WHATSAPP_TEMPLATE_PSYCHOLOGIST="psicoagenda_aviso_profesional"
# WHATSAPP_TEMPLATE_PATIENT_NOTICE="psicoagenda_aviso_paciente"
# WHATSAPP_TEMPLATE_PATIENT_CANCELLATION="psicoagenda_cancelacion_paciente"
# WHATSAPP_TEMPLATE_REMINDER="psicoagenda_recordatorio"

# Idioma de la plantilla y versión de Graph API.
WHATSAPP_TEMPLATE_LANG="en_US"
WHATSAPP_API_VERSION="v25.0"
#
# Meta registra cada plantilla con un idioma concreto y rechaza el envío si el
# `language.code` no coincide. La genérica (WHATSAPP_TEMPLATE_LANG) vale para
# todas; cada tipo de aviso puede declarar el suyo con las variantes
# WHATSAPP_TEMPLATE_LANG_* (p. ej. WHATSAPP_TEMPLATE_LANG_REMINDER="en").
# WHATSAPP_TEMPLATE_LANG_REMINDER="es_MX"

# Parámetros del cuerpo. Por defecto se envían tres, en este orden:
#   {{1}} nombre del destinatario, {{2}} mensaje del aviso, {{3}} fecha/hora.
#
# Para plantillas de texto plano (sin placeholders) define WHATSAPP_TEMPLATE_PARAMS=0.
WHATSAPP_TEMPLATE_PARAMS="3"
#
# Formato de los placeholders. Meta distingue dos tipos:
#   - POSITIONAL ({{1}}, {{2}}…): el valor por defecto, sin `parameter_name`.
#   - NAMED ({{nombre}}, {{fecha}}…): requiere WHATSAPP_TEMPLATE_NAMED=1 para que
#     cada parámetro lleve su `parameter_name`. La genérica vale para todas;
#     cada tipo puede declarar la suya con WHATSAPP_TEMPLATE_NAMED_*.
# WHATSAPP_TEMPLATE_NAMED="1"
#
# Para plantillas con placeholders distintos, declara la lista ordenada de
# campos que se inyectan como {{1}}, {{2}}, {{3}}… (o como el nombre del
# placeholder en las NAMED) separados por comas. Campos disponibles: nombre,
# asunto, accion (=asunto), mensaje, fecha, hora, fecha_hora, modalidad,
# empresa, tiempohasta.
#
# La genérica (WHATSAPP_TEMPLATE_BODY) vale para todas; cada tipo de aviso puede
# declarar la suya con las variantes WHATSAPP_TEMPLATE_BODY_* (mismo nombre que
# las de arriba, p. ej. WHATSAPP_TEMPLATE_BODY_REMINDER).
# WHATSAPP_TEMPLATE_BODY="nombre,mensaje,fecha_hora"
#
# Ejemplo con las plantillas propias de PsicoAgenda (NAMED, 4 parámetros):
#   WHATSAPP_TEMPLATE_NAMED="1"
#   WHATSAPP_TEMPLATE_BODY_PSYCHOLOGIST="nombre,accion,fecha,empresa"
#   WHATSAPP_TEMPLATE_BODY_PATIENT_NOTICE="nombre,accion,fecha,empresa"
#   WHATSAPP_TEMPLATE_BODY_PATIENT_CANCELLATION="nombre,fecha,accion,empresa"
#   WHATSAPP_TEMPLATE_BODY_REMINDER="nombre,fecha,empresa,tiempohasta"

# Token que Meta exige para suscribir el webhook de estados de entrega de
# WhatsApp (GET /api/webhooks/whatsapp?hub.mode=subscribe&hub.verify_token=...).
# Sin él el endpoint de verificación responde 403. El webhook de estados permite
# guardar el progreso real de cada mensaje: accepted, delivered, read, failed.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""

# --- Tareas internas (despacho de notificaciones) ---

# Secreto que autentica POST /api/internal/despachar. Ese endpoint envía correos
# y WhatsApp reales, así que no puede quedar abierto: sin este valor la API
# responde 503 (falla cerrado) en vez de aceptar cualquier petición.
#
# En un proceso de larga vida el barrido lo hace un `setInterval` y no hace falta
# configurarlo. En Vercel lo dispara un cron externo (cron-job.org) con la
# cabecera `Authorization: Bearer <CRON_SECRET>`; ver el ticket
# TICKET-2026-10-27-cron-externo.md. Para rotarlo, actualizar Vercel y el cron
# en ese orden (si no, el endpoint queda en 401 hasta el siguiente cambio).
#
# Generar uno: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=""
