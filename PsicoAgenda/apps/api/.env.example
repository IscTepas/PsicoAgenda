# URL de conexión a PostgreSQL. La usa tanto Prisma CLI (prisma.config.ts) como la app.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/psicoagenda?schema=public"

# Secreto para firmar los JWT. En producción es obligatorio (la app falla al arrancar si falta).
JWT_SECRET="cambia-este-secreto-por-uno-aleatorio-de-32-caracteres-o-mas"
JWT_EXPIRES_IN="7d"

PORT=4000
NODE_ENV="development"

# Origen permitido por CORS (frontend en desarrollo).
CORS_ORIGIN="http://localhost:3000"
